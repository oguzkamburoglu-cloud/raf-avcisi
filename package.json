{
  "name": "raf-avcisi",
  "version": "1.0.0",
  "private": true,
  "description": "Raf Avcısı - PickyList'in market rafı bulmaca oyunu",
  "scripts": {
    "build": "node scripts/build-www.mjs",
    "sync": "npm run build && npx cap sync",
    "assets": "npx -y @capacitor/assets@3 generate --iconBackgroundColor '#1F9D55' --iconBackgroundColorDark '#1F9D55' --splashBackgroundColor '#FBF5EC' --splashBackgroundColorDark '#FBF5EC'",
    "android": "npm run sync && npx cap open android",
    "ios": "npm run sync && npx cap open ios"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.3.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/native-purchases": "^8.9.6",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/noto-color-emoji": "^5.3.2",
    "@fontsource/roboto": "^5.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/ios": "^8.6.0"
  }
}
